{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenious.github.io/TagGen-Orbit/exchange/taggen-exchange-1.schema.json",
  "title": "taggen-exchange 1",
  "description": "Austausch von Hörspiel-Metadaten, Covern und Tag-Zuordnungen zwischen TeddyStudio und TagGen Orbit. Keine Audiodaten, keine lokalen Pfade, keine NFC-Rohdaten.",
  "type": "object",
  "required": ["format", "version", "meta", "entries"],
  "properties": {
    "format": { "const": "taggen-exchange" },
    "version": { "const": 1 },
    "minor": { "type": "integer", "minimum": 0 },
    "meta": {
      "type": "object",
      "required": ["app", "created", "privacy"],
      "properties": {
        "app": { "type": "string", "maxLength": 40 },
        "appVersion": { "type": "string", "maxLength": 40 },
        "created": { "type": "string", "format": "date-time" },
        "privacy": { "enum": ["private", "public"] },
        "collection": { "type": "string", "maxLength": 80 }
      }
    },
    "images": {
      "type": "object",
      "maxProperties": 500,
      "propertyNames": { "pattern": "^img-[A-Za-z0-9._-]{1,80}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "string", "pattern": "^data:image/(png|jpeg|webp);base64,", "maxLength": 4000000 },
          "source": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["key", "title"],
        "properties": {
          "key": { "type": "string", "pattern": "^(model:[A-Za-z0-9._-]{1,160}|audio:[A-Za-z0-9._-]{1,100}:[0-9a-fA-F]{40}|local:[0-9a-f]{24}|tag:[0-9a-f]{16})$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "series": { "type": "string", "maxLength": 120 },
          "episode": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
          "language": { "type": "string", "maxLength": 10 },
          "cover": {
            "type": "object",
            "properties": {
              "imageRef": { "type": "string" },
              "confirmed": { "type": "boolean" },
              "source": { "type": "string", "maxLength": 80 }
            }
          },
          "teddycloud": {
            "type": "object",
            "description": "Nur von TeddyStudio geschrieben; Orbit liest und reicht durch.",
            "properties": {
              "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$" },
              "audioIds": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 100 } },
              "hashes": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" } },
              "category": { "type": "string", "maxLength": 40 }
            }
          },
          "tag": {
            "type": "object",
            "properties": {
              "ruid": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "nfcUid": { "type": "string", "pattern": "^[0-9A-F]{2}( [0-9A-F]{2}){7}$" },
              "assignedModel": { "type": "string", "maxLength": 160 }
            }
          },
          "orbit": {
            "type": "object",
            "description": "Nur von Orbit geschrieben; TeddyStudio ignoriert es.",
            "properties": {
              "carrier": { "enum": ["unknown", "capsule43", "customTag", "creativeTonie", "originalTonie", "customFigure"] },
              "preset": { "type": "string", "maxLength": 40 },
              "printedAt": { "type": "string", "format": "date-time" }
            }
          },
          "origin": {
            "type": "object",
            "properties": {
              "teddystudioId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
              "exportedBy": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}
